# Mila's environment; the Alliance clusters' is in .drac.env.
# Sourced by slurm/scripts/build.sh and slurm/templates/mila.sh, with HC_BASE in the environment from healthcheck.py.
# Run `uv run healthcheck.py setup` again after changing these.
# No Alliance stack: system Open MPI, a pip-installed NCCL (build.sh) and uv's Python
export PROJECT=/network/projects  # Mila doesn't set it
export HC_PROJECT="$PROJECT/slurm-healthcheck"  # holds diskprobe/ for the $PROJECT read test
export HC_MODULES="cuda/12.6.0"
export HC_NCCL_TESTS_TAG=v2.21.1
export HC_NVCC_GENCODE="-gencode=arch=compute_80,code=sm_80 -gencode=arch=compute_90,code=sm_90"
export HC_MPI_HOME=/usr/lib/x86_64-linux-gnu/openmpi
export HC_NCCL_HOME="$HC_BASE/.opt/nccl/nvidia/nccl"
export HC_NCCL_PIP=nvidia-nccl-cu12==2.27.3
export LD_LIBRARY_PATH="$HC_NCCL_HOME/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
# Binaries in build/; keyed by the modules and arch, so changing either builds anew
HC_NCCL_TESTS_KEY=$(echo "$HC_MODULES $HC_NVCC_GENCODE" | sha256sum | cut -c1-8)
export HC_NCCL_TESTS="$HC_BASE/.opt/nccl-tests/$HC_NCCL_TESTS_TAG-$HC_NCCL_TESTS_KEY"
