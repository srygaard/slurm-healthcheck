# Mila's environment; the Alliance clusters' is in .drac.env.
# Sourced by slurm/scripts/build.sh and slurm/templates/mila.sh, with HC_BASE in the environment from healthcheck.py.
# Run `uv run healthcheck.py setup` again after changing these.
# No Alliance stack: pip-installed MPICH and NCCL (build.sh) and uv's Python
export PROJECT=/network/projects  # Mila doesn't set it
export HC_PROJECT="$PROJECT/slurm-healthcheck"  # holds diskprobe/ for the $PROJECT read test
export HC_MODULES="cuda/12.6.0"
export HC_NCCL_TESTS_TAG=v2.21.1
export HC_NVCC_GENCODE="-gencode=arch=compute_90,code=sm_90 -gencode=arch=compute_89,code=sm_89"  # H100 and L40S
# MPICH, not the system Open MPI 4: Slurm offers only srun --mpi=pmi2, and that Open MPI is a PMIx client, so every
# rank aborted in MPI_Init. As on Lynx (.lynx.env): MPICH's PMI-1 client works with pmi2, and nccl-tests only
# bootstraps over MPI, with NCCL bringing its own transport, so OFI over TCP is enough.
export HC_MPI_PIP=mpich==4.3.2
export HC_MPI_HOME="$HC_BASE/.opt/mpich-${HC_MPI_PIP#*==}"
export MPIR_CVAR_CH4_NETMOD=ofi FI_PROVIDER=tcp
export HC_NCCL_HOME="$HC_BASE/.opt/nccl/nvidia/nccl"
export HC_NCCL_PIP=nvidia-nccl-cu12==2.27.3
export LD_LIBRARY_PATH="$HC_NCCL_HOME/lib:$HC_MPI_HOME/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
# Binaries in build/; keyed by the modules, MPI and arch, so changing any builds anew
HC_NCCL_TESTS_KEY=$(echo "$HC_MODULES $HC_MPI_PIP $HC_NVCC_GENCODE" | sha256sum | cut -c1-8)
export HC_NCCL_TESTS="$HC_BASE/.opt/nccl-tests/$HC_NCCL_TESTS_TAG-$HC_NCCL_TESTS_KEY"
