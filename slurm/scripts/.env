# Sourced by the job templates in slurm/templates/, with HC_BASE in the environment from healthcheck.py.
# Run `uv run healthcheck.py setup` again after changing these.
export HC_MODULES="StdEnv/2023 gcc/12.3 openmpi/4.1.5 cuda/12.6 nccl/2.26.2 python/3.13"
export HC_BUILD_MODULES="httpproxy"  # build only: compute nodes reach git and PyPI through the proxy
export HC_NCCL_TESTS_TAG=v2.21.1
export HC_NCCL_TESTS="$HC_BASE/.opt/nccl-tests/$HC_NCCL_TESTS_TAG"  # binaries in build/
export HC_NVCC_GENCODE="-gencode=arch=compute_90,code=sm_90"
