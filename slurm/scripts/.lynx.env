# Lynx's environment; the Alliance clusters' is in .drac.env, Mila's in .mila.env.
# Sourced by slurm/scripts/build.sh and slurm/templates/lynx.sh, with HC_BASE in the environment from healthcheck.py.
# Run `uv run healthcheck.py setup` again after changing these.
# No Lmod or /cvmfs: MPI, CUDA and NCCL from pip wheels (build.sh); uv's Python
export PROJECT=/project  # Lynx doesn't set it
export HC_PROJECT="$PROJECT/slurm-healthcheck"  # holds diskprobe/ for the $PROJECT read test
export HC_MODULES=""
export HC_NCCL_TESTS_TAG=v2.21.1
export HC_NVCC_GENCODE="-gencode=arch=compute_100,code=sm_100"  # B200
# MPICH, not the system Open MPI 5: Slurm offers only srun --mpi=pmi2, which Open MPI 5 dropped.
# MPICH's PMI-1 client works with it, but UCX's address exchange is too big for it; nccl-tests only
# bootstraps over MPI and NCCL brings its own transport, so OFI over TCP is enough.
export HC_MPI_PIP=mpich==4.3.2
export HC_MPI_HOME="$HC_BASE/.opt/mpich-${HC_MPI_PIP#*==}"
# MPICH's CH4 ignores MPIR_CVAR_OFI_USE_PROVIDER; NCCL here has no OFI plugin, so FI_PROVIDER only reaches MPICH.
# libfabric's default provider left ranks hanging after the test.
export MPIR_CVAR_CH4_NETMOD=ofi FI_PROVIDER=tcp
# The compute fabric's pkey index 0 is 0x7fff, the default partition with limited membership, and two limited members
# can't talk (IBV_WC_RETRY_EXC_ERR); index 1 is 0x8001, full membership. mlx5_4-7 are on a second, node-local fabric:
# its own SM, and every node has the same LIDs.
export NCCL_IB_PKEY=1
export NCCL_IB_HCA=^=mlx5_4,mlx5_5,mlx5_6,mlx5_7
# nvcc's crt and nvvm dependencies are unpinned: a newer nvvm emits PTX that this ptxas rejects
export HC_CUDA_PIP="nvidia-cuda-nvcc==13.2.86 nvidia-cuda-crt==13.2.86 nvidia-nvvm==13.2.86 nvidia-cuda-runtime==13.2.86 nvidia-cuda-cccl==13.2.86"
# Keyed by the packages, so changing them installs anew
export HC_CUDA_TARGET="$HC_BASE/.opt/cuda-$(echo "$HC_CUDA_PIP" | sha256sum | cut -c1-8)"
export CUDA_HOME="$HC_CUDA_TARGET/nvidia/cu13"
export HC_NCCL_HOME="$HC_BASE/.opt/nccl/nvidia/nccl"
export HC_NCCL_PIP=nvidia-nccl-cu13==2.29.7
export LD_LIBRARY_PATH="$HC_NCCL_HOME/lib:$CUDA_HOME/lib:$HC_MPI_HOME/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
# Binaries in build/; keyed by the packages and arch, so changing either builds anew
HC_NCCL_TESTS_KEY=$(echo "$HC_MODULES $HC_MPI_PIP $HC_CUDA_PIP $HC_NCCL_PIP $HC_NVCC_GENCODE" | sha256sum | cut -c1-8)
export HC_NCCL_TESTS="$HC_BASE/.opt/nccl-tests/$HC_NCCL_TESTS_TAG-$HC_NCCL_TESTS_KEY"

# lynx sets /scratch/<u>/<user>, which isn't available yet.
# export SCRATCH="$HOME/scratch" in ~/.bashrc.
