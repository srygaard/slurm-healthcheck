# The Alliance (DRAC) clusters' environment: Fir, Rorqual, Tamia and Trillium; Mila's is in .mila.env.
# Sourced by slurm/scripts/build.sh and the job templates in slurm/templates/, with HC_BASE in the environment from healthcheck.py.
# Run `uv run healthcheck.py setup` again after changing these.
export PROJECT="$HOME/projects/rrg-bengioy-ad"
export HC_PROJECT="$PROJECT/slurm-healthcheck"  # holds diskprobe/ for the $PROJECT read test
export HC_MODULES="StdEnv/2023 gcc/12.3 openmpi/4.1.5 cuda/13.2 nccl/2.29.7 python/3.13"
export HC_NCCL_TESTS_TAG=v2.21.1
export HC_NVCC_GENCODE="-gencode=arch=compute_90,code=sm_90"
# Binaries in build/; keyed by the modules and arch, so changing either builds anew
HC_NCCL_TESTS_KEY=$(echo "$HC_MODULES $HC_NVCC_GENCODE" | sha256sum | cut -c1-8)
export HC_NCCL_TESTS="$HC_BASE/.opt/nccl-tests/$HC_NCCL_TESTS_TAG-$HC_NCCL_TESTS_KEY"
